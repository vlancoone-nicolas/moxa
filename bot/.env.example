# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore y NO se commitea NUNCA.

# ===== OpenAI =====
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo chat principal. gpt-4o-mini es 95% más barato que gpt-4o y basta para reservas.
OPENAI_MODEL=gpt-4o-mini

# ===== Evolution API =====
# URL donde corre Evolution (docker-compose la expone en localhost:8080)
EVOLUTION_API_URL=http://localhost:8080

# Token que configura docker-compose (coincide con AUTHENTICATION_API_KEY en docker-compose.yml)
EVOLUTION_API_KEY=moxa-demo-key-change-me

# Nombre de la instancia WhatsApp (la que creas vía Evolution Manager)
EVOLUTION_INSTANCE=moxa

# ===== Bot server =====
PORT=3000

# URL pública del bot (Cloudflare Tunnel o localhost). Evolution usa esto para webhooks.
# En dev con cloudflared quick tunnel, se actualiza en cada arranque.
PUBLIC_URL=http://localhost:3000

# ===== Zona horaria =====
TZ=Europe/Madrid

# ===== Whitelist demo (CRÍTICO) =====
# Lista de teléfonos (sin +, con prefijo país, sin espacios) separados por coma.
# Durante la demo el bot SOLO responde a estos números. Al resto los ignora
# (los verás como unread normal en tu WhatsApp y respondes tú a mano).
# Si lo dejas vacío → responderá a CUALQUIER número que te escriba. ⚠️
#
# Ejemplo (número del compañero + móvil secundario de demo):
# ALLOWED_PHONES=34612345678,34600000000
ALLOWED_PHONES=
