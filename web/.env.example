# Rellena con `vercel env pull .env.local --yes` tras linkear el proyecto
# y añadir las integraciones Marketplace.

# Provisionado por Marketplace → vercel integration add neon
DATABASE_URL=

# Pegar manualmente tras linkear: vercel env add OPENAI_API_KEY production preview development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Opcional
TZ=Europe/Madrid
